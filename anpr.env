# Konfigurasi Hybrid ANPR. Setelah mengubah: sudo systemctl restart anpr-api

# Alamat API. 0.0.0.0 = bisa dipanggil dari komputer lain di LAN; 127.0.0.1 = hanya dari komputer ini.
ANPR_HOST=0.0.0.0
ANPR_PORT=8090

# Kunci API: kalau diisi, aplikasi parkir wajib mengirim header "X-API-Key: <kunci>". Sangat disarankan,
# karena permintaan berisi password kamera. Buat kunci acak: openssl rand -hex 16
# Lebih mudah: panel admin -> Pengaturan -> Kunci API (buat & salin, tanpa restart; mengalahkan nilai di sini).
ANPR_API_KEY=

# Detik maksimal per pembacaan. Plat sulit yang sudah terdeteksi boleh sampai 2x nilai ini (mis. 1.5 -> maks 3 detik).
ANPR_MAX_TIME=1.5

# Model OCR utama: nama model bawaan, atau file hasil latih ulang (lihat README "Melatih ulang OCR"),
# mis. /var/lib/anpr/models/ocr_lokal_20261201.onnx (+ ocr_lokal_20261201_plate_config.yaml di folder yang sama).
ANPR_OCR_MODEL=cct-s-v2-global-model

# Pengumpul data latih: simpan potongan plat (±5-10 KB, bukan foto utuh) untuk melatih ulang OCR.
# Kosong = mati (default). Untuk mengaktifkan, mis.: ANPR_KUMPUL_DIR=/var/lib/anpr/kumpul (atau folder di HDD).
# Label diberi lewat halaman http://<ip-server>:<port>/label
ANPR_KUMPUL_DIR=
# Batas disk data latih (MB). Penuh -> potongan BELUM berlabel paling lama dihapus otomatis.
ANPR_KUMPUL_MAX_MB=500

# Panel admin: http://<ip-server>:<port>/admin
# Password awal admin. Kosong = dibuat acak dan ditulis ke /var/lib/anpr/admin_password_awal.txt.
# (Hanya dipakai saat akun admin pertama kali dibuat; setelah itu ganti password di panel -> Pengaturan.)
ANPR_ADMIN_USER=admin
ANPR_ADMIN_PASSWORD=
